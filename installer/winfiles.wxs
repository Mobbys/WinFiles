<?xml version="1.0" encoding="utf-8"?>
<!-- L'installer MSI di WinFiles (ADR 0014). Si compila con wixl (msitools), in CI e a mano:
     installer/crea-msi.sh winfiles.exe WinFiles.msi
     Installazione per l'utente, senza permessi di amministratore: %LocalAppData%\Programs\WinFiles,
     collegamento nel menu Start e sul Desktop, file .winfiles che si aprono con WinFiles,
     "Apri in WinFiles" nel tasto destro di Esplora file. Una versione nuova
     sostituisce la vecchia (stesso UpgradeCode, che non cambia mai). -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="WinFiles" Language="1040" Codepage="1252" Version="$(var.Version)"
           Manufacturer="Winsport" UpgradeCode="6B1F2B7E-4D0A-4F36-9C55-3A7E2E1D8C41">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser"
             Description="WinFiles $(var.Version)" Manufacturer="Winsport" Languages="1040" SummaryCodepage="1252" />
    <Property Id="ALLUSERS" Value="2" />
    <Property Id="MSIINSTALLPERUSER" Value="1" />
    <Property Id="ARPPRODUCTICON" Value="WinFilesIcon" />
    <Icon Id="WinFilesIcon" SourceFile="$(var.Icon)" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="È già installata una versione più recente di WinFiles." />
    <Media Id="1" Cabinet="winfiles.cab" EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLDIR" Name="WinFiles">
            <Component Id="Programma" Guid="0E3C1F6A-8B2D-4C57-A1E9-5D7F3B2C6A10">
              <File Id="WinFilesExe" Name="WinFiles.exe" Source="$(var.Exe)" />
<?ifdef var.Menu ?>
              <!-- La voce del menu corto di Windows 11 (ADR 0022): la DLL e il pacchetto firmato
                   che WinFiles registra al primo avvio. Senza certificato in CI non ci sono. -->
              <File Id="MenuDll" Name="winfiles_menu11.dll" Source="$(var.MenuDll)" />
              <File Id="MenuMsix" Name="WinFilesMenu.msix" Source="$(var.Menu)" />
<?endif ?>
              <RegistryValue Root="HKCU" Key="Software\WinFiles" Name="Cartella" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
              <RemoveFolder Id="RimuoviCartella" On="uninstall" />
            </Component>
<?ifdef var.Convertitori ?>
            <!-- I convertitori dei documenti di Word, Excel, PowerPoint e InDesign per Visualizza
                 (ADR 0035): girano in un processo a parte, chiamati da WinFiles. -->
            <Directory Id="CONVERTITORI" Name="convertitori">
              <Component Id="Convertitori" Guid="1292FFFB-80BD-4B7D-A61C-D348C73883EB">
                <File Id="ConvWord" Name="wordcraft-cli.exe" Source="$(var.Convertitori)/wordcraft-cli.exe" />
                <File Id="ConvExcel" Name="gridcraft-cli.exe" Source="$(var.Convertitori)/gridcraft-cli.exe" />
                <File Id="ConvPowerPoint" Name="deckcraft-cli.exe" Source="$(var.Convertitori)/deckcraft-cli.exe" />
                <File Id="ConvInDesign" Name="designcraft-cli.exe" Source="$(var.Convertitori)/designcraft-cli.exe" />
                <RegistryValue Root="HKCU" Key="Software\WinFiles" Name="Convertitori" Type="integer" Value="1" KeyPath="yes" />
                <RemoveFolder Id="RimuoviConvertitori" On="uninstall" />
              </Component>
            </Directory>
<?endif ?>
<?ifdef var.Anteprime ?>
            <!-- Le anteprime in Esplora file (ADR 0036): la DLL che disegna PDF, AI, EPS, PSD, RAW,
                 HEIC, SVG, DXF, DWG e PLT nelle cartelle a icone grandi. Solo l'anteprima: il
                 programma predefinito di ogni file non cambia. -->
            <Component Id="Anteprime" Guid="4D6F2A93-1C8E-4B5D-A7F0-3E9B1C2D5A68">
              <File Id="AnteprimeDll" Name="winfiles_preview.dll" Source="$(var.Anteprime)" />
              <RegistryValue Root="HKCU" Key="Software\WinFiles" Name="Anteprime" Type="integer" Value="1" KeyPath="yes" />
              <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" Type="string" Value="Anteprime di WinFiles" />
              <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}\InprocServer32" Type="string" Value="[INSTALLDIR]winfiles_preview.dll" />
              <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}\InprocServer32" Name="ThreadingModel" Type="string" Value="Apartment" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.pdf\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.ai\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.eps\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.psd\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.psb\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.heic\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.heif\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.webp\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.tga\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.dng\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.cr2\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.cr3\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.nef\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.nrw\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.arw\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.orf\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.rw2\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.raf\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.pef\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.svg\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.svgz\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.dxf\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.dwg\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.plt\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
              <RegistryValue Root="HKCU" Key="Software\Classes\.hpgl\ShellEx\{e357fccd-a995-4576-b01f-234630154e96}" Type="string" Value="{8B3C7E21-5D4A-4F96-9C1B-2E7A6D0F4B53}" />
            </Component>
<?endif ?>
            <Component Id="FileWinfiles" Guid="7C2A9E41-3F6B-4D18-B0A5-9E4C2D7F1B36">
              <RegistryValue Root="HKCU" Key="Software\Classes\.winfiles" Type="string" Value="WinFiles.Lavoro" KeyPath="yes" />
              <RegistryValue Root="HKCU" Key="Software\Classes\WinFiles.Lavoro" Type="string" Value="Lavoro WinFiles" />
              <RegistryValue Root="HKCU" Key="Software\Classes\WinFiles.Lavoro\DefaultIcon" Type="string" Value="[INSTALLDIR]WinFiles.exe,0" />
              <RegistryValue Root="HKCU" Key="Software\Classes\WinFiles.Lavoro\shell\open\command" Type="string" Value="&quot;[INSTALLDIR]WinFiles.exe&quot; &quot;%1&quot;" />
              <RegistryValue Root="HKCU" Key="Software\Classes\Applications\WinFiles.exe\shell\open\command" Type="string" Value="&quot;[INSTALLDIR]WinFiles.exe&quot; &quot;%1&quot;" />
            </Component>
            <!-- "Apri in WinFiles" nel tasto destro di Esplora file, su file, cartelle e sfondo della
                 cartella aperta. Esplora file avvia WinFiles una volta per file: con l'opzione aggiungi i
                 file finiscono tutti nella stessa finestra (instance.rs). Su Windows 11 la voce sta
                 in "Mostra altre opzioni". -->
            <Component Id="MenuTastoDestro" Guid="5B8E0C27-91D4-4F3A-A6E2-7C1D3F9B4E85">
              <RegistryValue Root="HKCU" Key="Software\WinFiles" Name="MenuTastoDestro" Type="integer" Value="1" KeyPath="yes" />
              <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\WinFiles" Type="string" Value="Apri in WinFiles" />
              <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\WinFiles" Name="Icon" Type="string" Value="[INSTALLDIR]WinFiles.exe,0" />
              <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\WinFiles" Name="MultiSelectModel" Type="string" Value="Player" />
              <RegistryValue Root="HKCU" Key="Software\Classes\*\shell\WinFiles\command" Type="string" Value="&quot;[INSTALLDIR]WinFiles.exe&quot; --aggiungi &quot;%1&quot;" />
              <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\WinFiles" Type="string" Value="Apri in WinFiles" />
              <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\WinFiles" Name="Icon" Type="string" Value="[INSTALLDIR]WinFiles.exe,0" />
              <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\WinFiles" Name="MultiSelectModel" Type="string" Value="Player" />
              <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\WinFiles\command" Type="string" Value="&quot;[INSTALLDIR]WinFiles.exe&quot; --aggiungi &quot;%1&quot;" />
              <RegistryValue Root="HKCU" Key="Software\Classes\Directory\Background\shell\WinFiles" Type="string" Value="Apri in WinFiles" />
              <RegistryValue Root="HKCU" Key="Software\Classes\Directory\Background\shell\WinFiles" Name="Icon" Type="string" Value="[INSTALLDIR]WinFiles.exe,0" />
              <RegistryValue Root="HKCU" Key="Software\Classes\Directory\Background\shell\WinFiles" Name="MultiSelectModel" Type="string" Value="Player" />
              <RegistryValue Root="HKCU" Key="Software\Classes\Directory\Background\shell\WinFiles\command" Type="string" Value="&quot;[INSTALLDIR]WinFiles.exe&quot; --aggiungi &quot;%V&quot;" />
            </Component>
            <!-- "Invia al nesting WinFiles" nel tasto destro dei file che il nesting sa aprire
                 (menu classico; su Windows 11 c'è anche nel menu corto, AppxManifest.xml). -->
            <Component Id="MenuNesting" Guid="C3A1E9D2-5B47-4E8F-9A06-1D2E3F4A5B6C">
              <RegistryValue Root="HKCU" Key="Software\WinFiles" Name="MenuNesting" Type="integer" Value="1" KeyPath="yes" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\WinFilesNesting" Type="string" Value="Invia al nesting WinFiles" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\WinFilesNesting" Name="Icon" Type="string" Value="[INSTALLDIR]WinFiles.exe,0" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\WinFilesNesting" Name="MultiSelectModel" Type="string" Value="Player" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.pdf\shell\WinFilesNesting\command" Type="string" Value="&quot;[INSTALLDIR]WinFiles.exe&quot; --invia-nesting &quot;%1&quot;" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.ai\shell\WinFilesNesting" Type="string" Value="Invia al nesting WinFiles" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.ai\shell\WinFilesNesting" Name="Icon" Type="string" Value="[INSTALLDIR]WinFiles.exe,0" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.ai\shell\WinFilesNesting" Name="MultiSelectModel" Type="string" Value="Player" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.ai\shell\WinFilesNesting\command" Type="string" Value="&quot;[INSTALLDIR]WinFiles.exe&quot; --invia-nesting &quot;%1&quot;" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.eps\shell\WinFilesNesting" Type="string" Value="Invia al nesting WinFiles" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.eps\shell\WinFilesNesting" Name="Icon" Type="string" Value="[INSTALLDIR]WinFiles.exe,0" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.eps\shell\WinFilesNesting" Name="MultiSelectModel" Type="string" Value="Player" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.eps\shell\WinFilesNesting\command" Type="string" Value="&quot;[INSTALLDIR]WinFiles.exe&quot; --invia-nesting &quot;%1&quot;" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\WinFilesNesting" Type="string" Value="Invia al nesting WinFiles" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\WinFilesNesting" Name="Icon" Type="string" Value="[INSTALLDIR]WinFiles.exe,0" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\WinFilesNesting" Name="MultiSelectModel" Type="string" Value="Player" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.jpg\shell\WinFilesNesting\command" Type="string" Value="&quot;[INSTALLDIR]WinFiles.exe&quot; --invia-nesting &quot;%1&quot;" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\WinFilesNesting" Type="string" Value="Invia al nesting WinFiles" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\WinFilesNesting" Name="Icon" Type="string" Value="[INSTALLDIR]WinFiles.exe,0" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\WinFilesNesting" Name="MultiSelectModel" Type="string" Value="Player" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\WinFilesNesting\command" Type="string" Value="&quot;[INSTALLDIR]WinFiles.exe&quot; --invia-nesting &quot;%1&quot;" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.png\shell\WinFilesNesting" Type="string" Value="Invia al nesting WinFiles" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.png\shell\WinFilesNesting" Name="Icon" Type="string" Value="[INSTALLDIR]WinFiles.exe,0" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.png\shell\WinFilesNesting" Name="MultiSelectModel" Type="string" Value="Player" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.png\shell\WinFilesNesting\command" Type="string" Value="&quot;[INSTALLDIR]WinFiles.exe&quot; --invia-nesting &quot;%1&quot;" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.tif\shell\WinFilesNesting" Type="string" Value="Invia al nesting WinFiles" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.tif\shell\WinFilesNesting" Name="Icon" Type="string" Value="[INSTALLDIR]WinFiles.exe,0" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.tif\shell\WinFilesNesting" Name="MultiSelectModel" Type="string" Value="Player" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.tif\shell\WinFilesNesting\command" Type="string" Value="&quot;[INSTALLDIR]WinFiles.exe&quot; --invia-nesting &quot;%1&quot;" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\WinFilesNesting" Type="string" Value="Invia al nesting WinFiles" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\WinFilesNesting" Name="Icon" Type="string" Value="[INSTALLDIR]WinFiles.exe,0" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\WinFilesNesting" Name="MultiSelectModel" Type="string" Value="Player" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.tiff\shell\WinFilesNesting\command" Type="string" Value="&quot;[INSTALLDIR]WinFiles.exe&quot; --invia-nesting &quot;%1&quot;" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.psd\shell\WinFilesNesting" Type="string" Value="Invia al nesting WinFiles" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.psd\shell\WinFilesNesting" Name="Icon" Type="string" Value="[INSTALLDIR]WinFiles.exe,0" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.psd\shell\WinFilesNesting" Name="MultiSelectModel" Type="string" Value="Player" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.psd\shell\WinFilesNesting\command" Type="string" Value="&quot;[INSTALLDIR]WinFiles.exe&quot; --invia-nesting &quot;%1&quot;" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.webp\shell\WinFilesNesting" Type="string" Value="Invia al nesting WinFiles" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.webp\shell\WinFilesNesting" Name="Icon" Type="string" Value="[INSTALLDIR]WinFiles.exe,0" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.webp\shell\WinFilesNesting" Name="MultiSelectModel" Type="string" Value="Player" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.webp\shell\WinFilesNesting\command" Type="string" Value="&quot;[INSTALLDIR]WinFiles.exe&quot; --invia-nesting &quot;%1&quot;" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\WinFilesNesting" Type="string" Value="Invia al nesting WinFiles" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\WinFilesNesting" Name="Icon" Type="string" Value="[INSTALLDIR]WinFiles.exe,0" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\WinFilesNesting" Name="MultiSelectModel" Type="string" Value="Player" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.bmp\shell\WinFilesNesting\command" Type="string" Value="&quot;[INSTALLDIR]WinFiles.exe&quot; --invia-nesting &quot;%1&quot;" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.heic\shell\WinFilesNesting" Type="string" Value="Invia al nesting WinFiles" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.heic\shell\WinFilesNesting" Name="Icon" Type="string" Value="[INSTALLDIR]WinFiles.exe,0" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.heic\shell\WinFilesNesting" Name="MultiSelectModel" Type="string" Value="Player" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.heic\shell\WinFilesNesting\command" Type="string" Value="&quot;[INSTALLDIR]WinFiles.exe&quot; --invia-nesting &quot;%1&quot;" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.heif\shell\WinFilesNesting" Type="string" Value="Invia al nesting WinFiles" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.heif\shell\WinFilesNesting" Name="Icon" Type="string" Value="[INSTALLDIR]WinFiles.exe,0" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.heif\shell\WinFilesNesting" Name="MultiSelectModel" Type="string" Value="Player" />
              <RegistryValue Root="HKCU" Key="Software\Classes\SystemFileAssociations\.heif\shell\WinFilesNesting\command" Type="string" Value="&quot;[INSTALLDIR]WinFiles.exe&quot; --invia-nesting &quot;%1&quot;" />
            </Component>
            <!-- WinFiles come CANDIDATO per aprire questi file con il doppio clic, nella scheda
                 Visualizza (ADR 0032): un ProgID per tipo, la voce in "Apri con" e la pagina di
                 WinFiles in App predefinite. Nessun tipo cambia programma: lo sceglie chi usa
                 WinFiles da Aiuto › Programma predefinito…, confermando nelle Impostazioni. -->
            <Component Id="Visualizza" Guid="8D4F2A61-7C3B-4E95-B1A8-2F6E9C0D3B47">
              <RegistryValue Root="HKCU" Key="Software\WinFiles" Name="Visualizza" Type="integer" Value="1" KeyPath="yes" />
              <RegistryValue Root="HKCU" Key="Software\WinFiles\Capabilities" Name="ApplicationName" Type="string" Value="WinFiles" />
              <RegistryValue Root="HKCU" Key="Software\WinFiles\Capabilities" Name="ApplicationDescription" Type="string" Value="Guarda PDF, Illustrator, EPS, immagini e disegni DXF/DWG con le misure vere e le tinte piatte" />
              <RegistryValue Root="HKCU" Key="Software\WinFiles\Capabilities" Name="ApplicationIcon" Type="string" Value="[INSTALLDIR]WinFiles.exe,0" />
